{
  "name": "meeting-scheduler-server",
  "version": "1.0.0",
  "description": "Production-ready backend API for distributed meeting scheduling",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
